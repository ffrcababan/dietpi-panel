# DietPi Panel Environment Configuration
# Copy to /etc/dietpi-panel/panel.env (install.sh generates secrets automatically)

# Base domain used for <name>.<BASE_DOMAIN> subdomains (panel.<BASE_DOMAIN> for the dashboard)
BASE_DOMAIN=mydomain.com

# Shared secret for authenticating Next.js -> /run/control-agent.sock (min 32 random chars)
AGENT_SECRET=replace-with-openssl-rand-hex-32

# HMAC secret for signing httpOnly session cookies (min 32 random chars)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Path to the panel's internal SQLite database (admin users, TOTP secrets)
DB_PATH=/srv/db/_panel/panel.sqlite

# Path to the Control Agent Unix domain socket
AGENT_SOCKET=/run/control-agent.sock

# Next.js runtime bind settings (fronted by Apache TLS reverse proxy)
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
