# Enforce Unix LF line endings for Linux scripts, configs, and source files
* text=auto eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.tmpl text eol=lf
*.php text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
scripts/* text eol=lf
