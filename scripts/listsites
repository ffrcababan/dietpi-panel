#!/usr/bin/env bash
set -euo pipefail

# listsites
# Parses enabled Apache virtual hosts in /etc/apache2/sites-enabled/*.conf and outputs a JSON array of
# {name, serverName, docroot, type, ssl, port, hasDb, isPanel}.

if [[ -f /etc/control-agent/config.env ]]; then
    # shellcheck disable=SC1091
    source /etc/control-agent/config.env
fi

APACHE_DIR="${APACHE_DIR:-/etc/apache2}"
APACHE_SITES_EN="${APACHE_SITES_EN:-${APACHE_DIR}/sites-enabled}"

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/}"
    s="${s//$'\r'/}"
    s="${s//$'\t'/}"
    printf '%s' "$s"
}

shopt -s nullglob
enabled_files=("${APACHE_SITES_EN}"/*.conf)
extra_ssl_files=("${APACHE_DIR}/conf.d/"*-le-ssl.conf)
shopt -u nullglob

# Pass 1: collect SSL-enabled ServerNames and primary (non -le-ssl) ServerNames
ssl_domains=" "
primary_domains=" "
for f in "${enabled_files[@]}" "${extra_ssl_files[@]}"; do
    [[ -f "$f" && -r "$f" ]] || continue
    base="${f##*/}"
    sn="$(awk '{gsub(/\r/,"")} tolower($1)=="servername" {gsub(/^["'\'']|["'\'']$/,"",$2); print tolower($2); exit}' "$f" || true)"
    if grep -qiE '^\s*SSLEngine\s+on\b' "$f"; then
        [[ -n "$sn" ]] && ssl_domains+="${sn} "
    fi
    if [[ "$base" != *-le-ssl.conf ]]; then
        [[ -n "$sn" ]] && primary_domains+="${sn} "
    fi
done

printf '['
first=1
for f in "${enabled_files[@]}"; do
    [[ -f "$f" && -r "$f" ]] || continue
    base="${f##*/}"
    stem="${base%.conf}"

    server_name="$(awk '{gsub(/\r/,"")} tolower($1)=="servername" {gsub(/^["'\'']|["'\'']$/,"",$2); print $2; exit}' "$f" || true)"
    sn_lower="$(printf '%s' "$server_name" | tr '[:upper:]' '[:lower:]')"

    # Skip unconfigured stock Apache defaults when they have no ServerName
    if [[ ( "$base" == "000-default.conf" || "$base" == "default-ssl.conf" ) && -z "$server_name" ]]; then
        continue
    fi

    # Skip Certbot companion -le-ssl.conf when its base vhost is already listed
    if [[ "$base" == *-le-ssl.conf ]]; then
        base_stem="${base%-le-ssl.conf}"
        if [[ -e "${APACHE_SITES_EN}/${base_stem}.conf" ]] || [[ -n "$sn_lower" && "$primary_domains" == *" ${sn_lower} "* ]]; then
            continue
        fi
        stem="$base_stem"
    fi

    name="$(awk '{gsub(/\r/,"")} /^# dietpi-panel:name=/{sub(/^# dietpi-panel:name=/,""); print; exit}' "$f" || true)"
    if [[ -z "$name" ]]; then
        name="$stem"
    fi

    site_type="$(awk '{gsub(/\r/,"")} /^# dietpi-panel:type=/{sub(/^# dietpi-panel:type=/,""); print; exit}' "$f" || true)"
    if [[ -z "$site_type" ]]; then
        site_type="custom"
    fi

    port_val="$(awk '{gsub(/\r/,"")} /^# dietpi-panel:port=/{sub(/^# dietpi-panel:port=/,""); if ($0 ~ /^[0-9]+$/) print; exit}' "$f" || true)"
    if [[ -z "$port_val" ]]; then
        port_json="null"
    else
        port_json="$port_val"
    fi

    docroot="$(awk '{gsub(/\r/,"")} tolower($1)=="documentroot" {gsub(/^["'\'']|["'\'']$/,"",$2); print $2; exit}' "$f" || true)"
    if [[ -z "$server_name" ]]; then
        server_name="$stem"
    fi
    if [[ -z "$docroot" ]]; then
        if [[ "$site_type" == "panel" ]]; then
            docroot="http://127.0.0.1:3000"
        else
            docroot="/var/www/${name}"
        fi
    fi

    ssl_flag="false"
    if [[ -e "${APACHE_SITES_EN}/${stem}-le-ssl.conf" ]] || [[ -n "$sn_lower" && "$ssl_domains" == *" ${sn_lower} "* ]]; then
        ssl_flag="true"
    fi

    has_db="false"
    if [[ -f "/srv/db/${name}/data.sqlite" ]]; then
        has_db="true"
    fi

    is_panel="false"
    if [[ "$name" == "dietpi-panel" || "$site_type" == "panel" ]]; then
        is_panel="true"
    fi

    if [[ $first -eq 0 ]]; then
        printf ','
    fi
    first=0

    printf '{"name":"%s","serverName":"%s","docroot":"%s","type":"%s","ssl":%s,"port":%s,"hasDb":%s,"isPanel":%s}' \
        "$(json_escape "$name")" \
        "$(json_escape "$server_name")" \
        "$(json_escape "$docroot")" \
        "$(json_escape "$site_type")" \
        "$ssl_flag" \
        "$port_json" \
        "$has_db" \
        "$is_panel"
done
printf ']\n'
