#!/usr/bin/env bash
set -euo pipefail

# mksite <name> <type> [domain] [port]
# Creates an Apache vhost, docroot /var/www/<name>, aliases /db.php,
# creates a systemd service template for runtime apps (nextjs, node, python),
# enables the site, and reloads Apache.

if [[ -f /etc/control-agent/config.env ]]; then
    # shellcheck disable=SC1091
    source /etc/control-agent/config.env
fi

WEB_USER="${WEB_USER:-www-data}"
WEB_GROUP="${WEB_GROUP:-$WEB_USER}"
APACHE_SERVICE="${APACHE_SERVICE:-apache2}"
APACHE_CTL="${APACHE_CTL:-$(command -v apache2ctl >/dev/null 2>&1 && echo apache2ctl || echo apachectl)}"
APACHE_DIR="${APACHE_DIR:-/etc/apache2}"
APACHE_SITES_AVAIL="${APACHE_SITES_AVAIL:-${APACHE_DIR}/sites-available}"
APACHE_SITES_EN="${APACHE_SITES_EN:-${APACHE_DIR}/sites-enabled}"
APACHE_CONF_DB="${APACHE_CONF_DB:-${APACHE_DIR}/conf-app-db}"

NAME="${1:-}"
TYPE="${2:-}"
CUSTOM_DOMAIN="${3:-}"
REQUESTED_PORT="${4:-}"

if [[ ! "$NAME" =~ ^[a-z0-9-]{1,32}$ ]]; then
    echo "Invalid site name: must match ^[a-z0-9-]{1,32}$" >&2
    exit 1
fi

case "$NAME" in
    panel|dietpi-panel|backups|www|localhost|default|shared)
        echo "Reserved name cannot be used for a site: $NAME" >&2
        exit 1
        ;;
esac

if [[ ! "$TYPE" =~ ^(static|php|laravel|react|vue|astro|sveltekit|nextjs|node|python)$ ]]; then
    echo "Invalid site type: must be one of static, php, laravel, react, vue, astro, sveltekit, nextjs, node, python" >&2
    exit 1
fi

BASE_DOMAIN="${BASE_DOMAIN:-localhost}"
if [[ -n "$CUSTOM_DOMAIN" ]]; then
    if [[ ${#CUSTOM_DOMAIN} -gt 253 || ! "$CUSTOM_DOMAIN" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]; then
        echo "Invalid custom domain: $CUSTOM_DOMAIN" >&2
        exit 1
    fi
    DOMAIN="$CUSTOM_DOMAIN"
else
    DOMAIN="${NAME}.${BASE_DOMAIN}"
fi

if [[ "$DOMAIN" == "panel.${BASE_DOMAIN}" ]]; then
    echo "Cannot overwrite the panel domain: $DOMAIN" >&2
    exit 1
fi

VHOST_FILE="${APACHE_SITES_AVAIL}/${NAME}.conf"
SITE_ROOT="/var/www/${NAME}"
SHARED_DB_PHP="/var/www/_shared/db.php"

if [[ ! -f "$SHARED_DB_PHP" ]]; then
    echo "Shared endpoint missing: $SHARED_DB_PHP" >&2
    exit 1
fi

if [[ -f "$VHOST_FILE" ]]; then
    if ! grep -q '^# dietpi-panel:type=dbonly$' "$VHOST_FILE"; then
        echo "Site already exists: $NAME" >&2
        exit 1
    fi
fi

# Check no other vhost already claims this ServerName
shopt -s nullglob
for existing_conf in "${APACHE_SITES_AVAIL}"/*.conf; do
    if [[ "$existing_conf" == "$VHOST_FILE" ]]; then
        continue
    fi
    existing_sn="$(awk 'tolower($1)=="servername" {print tolower($2); exit}' "$existing_conf" || true)"
    if [[ "$existing_sn" == "$DOMAIN" ]]; then
        echo "Domain already configured in another virtual host: $DOMAIN" >&2
        exit 1
    fi
done
shopt -u nullglob

IS_PROXY=0
if [[ "$TYPE" == "nextjs" || "$TYPE" == "node" || "$TYPE" == "python" ]]; then
    IS_PROXY=1
fi

PORT="0"
if (( IS_PROXY == 1 )); then
    if [[ -n "$REQUESTED_PORT" ]]; then
        if [[ ! "$REQUESTED_PORT" =~ ^[0-9]+$ ]] || (( REQUESTED_PORT < 3001 || REQUESTED_PORT > 39999 )); then
            echo "Invalid port for ${TYPE} site: must be integer 3001..39999" >&2
            exit 1
        fi
        PORT="$REQUESTED_PORT"
    else
        used_ports=" $( (grep -RhoE '127\.0\.0\.1:[0-9]+' "${APACHE_SITES_AVAIL}"/*.conf 2>/dev/null || true) | awk -F: '{print $2}' | tr '\n' ' ') "
        candidate=3100
        while (( candidate <= 39999 )); do
            if [[ "$used_ports" != *" ${candidate} "* ]]; then
                if ! command -v ss >/dev/null 2>&1 || ! ss -H -tln 2>/dev/null | awk -v p=":${candidate}$" '$4 ~ p {found=1} END {exit !found}'; then
                    PORT="$candidate"
                    break
                fi
            fi
            candidate=$((candidate + 1))
        done
        if (( PORT == 0 )); then
            echo "No free local port found in range 3100..39999" >&2
            exit 1
        fi
    fi
fi

# Determine docroot and template
DOCROOT="$SITE_ROOT"
FALLBACK_DIRECTIVE=""
SKEL_VHOST="/etc/skel/vhost-${TYPE}.conf"

case "$TYPE" in
    static|php)
        DOCROOT="$SITE_ROOT"
        ;;
    laravel)
        DOCROOT="${SITE_ROOT}/public"
        ;;
    react|vue)
        DOCROOT="${SITE_ROOT}/dist"
        FALLBACK_DIRECTIVE="FallbackResource /index.html"
        SKEL_VHOST="/etc/skel/vhost-spa.conf"
        ;;
    astro)
        DOCROOT="${SITE_ROOT}/dist"
        FALLBACK_DIRECTIVE=""
        SKEL_VHOST="/etc/skel/vhost-spa.conf"
        ;;
    sveltekit)
        DOCROOT="${SITE_ROOT}/build"
        FALLBACK_DIRECTIVE="FallbackResource /index.html"
        SKEL_VHOST="/etc/skel/vhost-spa.conf"
        ;;
    nextjs)
        DOCROOT="$SITE_ROOT"
        SKEL_VHOST="/etc/skel/vhost-nextjs.conf"
        ;;
    node|python)
        DOCROOT="$SITE_ROOT"
        SKEL_VHOST="/etc/skel/vhost-proxy.conf"
        ;;
esac

if [[ ! -f "$SKEL_VHOST" ]]; then
    echo "Template missing: $SKEL_VHOST" >&2
    exit 1
fi

mkdir -p "$SITE_ROOT" "$DOCROOT" "$APACHE_SITES_AVAIL" "$APACHE_SITES_EN" "$APACHE_CONF_DB"
chown -R "${WEB_USER}:${WEB_GROUP}" "$SITE_ROOT"
chmod 0755 "$SITE_ROOT" "$DOCROOT"
ln -sfn "$SHARED_DB_PHP" "${SITE_ROOT}/db.php"

# Seed a clean placeholder entrypoint when empty
if [[ "$TYPE" == "php" ]]; then
    if [[ ! -f "${DOCROOT}/index.php" && ! -f "${DOCROOT}/index.html" ]]; then
        cat > "${DOCROOT}/index.php" <<EOF
<?php
header('Content-Type: text/html; charset=utf-8');
?>
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title><?= htmlspecialchars('${DOMAIN}') ?></title></head>
<body style="font-family:system-ui,sans-serif;background:#0b0e14;color:#e2e8f0;padding:3rem">
<h1><?= htmlspecialchars('${DOMAIN}') ?></h1>
<p>PHP site <code><?= htmlspecialchars('${NAME}') ?></code> is live (PHP <?= PHP_VERSION ?>).</p>
</body>
</html>
EOF
        chown "${WEB_USER}:${WEB_GROUP}" "${DOCROOT}/index.php"
    fi
elif [[ "$TYPE" == "laravel" ]]; then
    if [[ ! -f "${DOCROOT}/index.php" ]]; then
        cat > "${DOCROOT}/index.php" <<EOF
<?php
header('Content-Type: text/html; charset=utf-8');
?>
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title><?= htmlspecialchars('${DOMAIN}') ?></title></head>
<body style="font-family:system-ui,sans-serif;background:#0b0e14;color:#e2e8f0;padding:3rem">
<h1><?= htmlspecialchars('${DOMAIN}') ?></h1>
<p>Laravel document root <code>${DOCROOT}</code> is ready. Upload or git-clone your Laravel project into <code>${SITE_ROOT}</code>.</p>
</body>
</html>
EOF
        chown "${WEB_USER}:${WEB_GROUP}" "${DOCROOT}/index.php"
    fi
elif (( IS_PROXY == 0 )); then
    if [[ ! -f "${DOCROOT}/index.html" ]]; then
        cat > "${DOCROOT}/index.html" <<EOF
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>${DOMAIN}</title></head>
<body style="font-family:system-ui,sans-serif;background:#0b0e14;color:#e2e8f0;padding:3rem">
<h1>${DOMAIN}</h1>
<p>${TYPE} site <code>${NAME}</code> is live on DietPi Panel.</p>
</body>
</html>
EOF
        chown "${WEB_USER}:${WEB_GROUP}" "${DOCROOT}/index.html"
    fi
else
    SYSTEMD_UNIT="/etc/systemd/system/app-${NAME}.service"
    SKEL_SERVICE="/etc/skel/app-service.tmpl"
    if [[ ! -f "$SKEL_SERVICE" ]]; then
        SKEL_SERVICE="/etc/skel/app-nextjs.service.tmpl"
    fi
    if [[ "$TYPE" == "nextjs" ]]; then
        ENV_FILE=".env.local"
        EXEC_START="/usr/bin/env npm run start"
    elif [[ "$TYPE" == "node" ]]; then
        ENV_FILE=".env"
        EXEC_START="/usr/bin/env npm run start"
    else
        ENV_FILE=".env"
        EXEC_START="${SITE_ROOT}/.venv/bin/python ${SITE_ROOT}/app.py"
    fi
    if [[ ! -f "$SYSTEMD_UNIT" && -f "$SKEL_SERVICE" ]]; then
        sed -e "s|__NAME__|${NAME}|g" \
            -e "s|__TYPE__|${TYPE}|g" \
            -e "s|__PORT__|${PORT}|g" \
            -e "s|__WEB_USER__|${WEB_USER}|g" \
            -e "s|__WEB_GROUP__|${WEB_GROUP}|g" \
            -e "s|__ENV_FILE__|${ENV_FILE}|g" \
            -e "s|__EXEC_START__|${EXEC_START}|g" \
            "$SKEL_SERVICE" > "$SYSTEMD_UNIT"
        chmod 0644 "$SYSTEMD_UNIT"
        systemctl daemon-reload
    fi
fi

BACKUP_OLD_VHOST=""
if [[ -f "$VHOST_FILE" ]]; then
    BACKUP_OLD_VHOST="${VHOST_FILE}.bak"
    cp -a "$VHOST_FILE" "$BACKUP_OLD_VHOST"
fi

sed -e "s|__NAME__|${NAME}|g" \
    -e "s|__TYPE__|${TYPE}|g" \
    -e "s|__DOMAIN__|${DOMAIN}|g" \
    -e "s|__DOCROOT__|${DOCROOT}|g" \
    -e "s|__CONF_DB_DIR__|${APACHE_CONF_DB}|g" \
    -e "s|__FALLBACK_DIRECTIVE__|${FALLBACK_DIRECTIVE}|g" \
    -e "s|__PORT__|${PORT}|g" \
    "$SKEL_VHOST" > "$VHOST_FILE"
chmod 0644 "$VHOST_FILE"

if command -v a2ensite >/dev/null 2>&1 && [[ "$APACHE_DIR" == "/etc/apache2" ]] && [[ -d "/etc/apache2/mods-available" ]]; then
    a2ensite "${NAME}.conf" >/dev/null
else
    ln -sfn "../sites-available/${NAME}.conf" "${APACHE_SITES_EN}/${NAME}.conf"
fi

if ! "$APACHE_CTL" configtest >/dev/null 2>&1; then
    if [[ -n "$BACKUP_OLD_VHOST" && -f "$BACKUP_OLD_VHOST" ]]; then
        mv -f "$BACKUP_OLD_VHOST" "$VHOST_FILE"
    else
        if command -v a2dissite >/dev/null 2>&1 && [[ "$APACHE_DIR" == "/etc/apache2" ]] && [[ -d "/etc/apache2/mods-available" ]]; then
            a2dissite "${NAME}.conf" >/dev/null 2>&1 || true
        else
            rm -f "${APACHE_SITES_EN}/${NAME}.conf"
        fi
        rm -f "$VHOST_FILE"
    fi
    echo "Apache configtest failed for ${NAME}.conf; rolled back" >&2
    exit 1
fi
rm -f "$BACKUP_OLD_VHOST"
systemctl reload "$APACHE_SERVICE"

if (( IS_PROXY == 1 )); then
    printf '{"name":"%s","type":"%s","domain":"%s","docroot":"%s","port":%s}\n' \
        "$NAME" "$TYPE" "$DOMAIN" "$DOCROOT" "$PORT"
else
    printf '{"name":"%s","type":"%s","domain":"%s","docroot":"%s","port":null}\n' \
        "$NAME" "$TYPE" "$DOMAIN" "$DOCROOT"
fi
